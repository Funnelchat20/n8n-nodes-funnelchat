					{
						"name": "status",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": [
								"completed",
								"pending",
								"not_sent",
								"unfinished"
							]
						},
						"description": "Status of the response."
					},
					{
						"name": "search",
						"in": "query",
						"schema": {
							"type": "string"
						},
						"description": "Searches by contact."
					},
					{
						"name": "per_page",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "page",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					}
				],
