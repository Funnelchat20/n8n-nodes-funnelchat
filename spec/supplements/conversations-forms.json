		"/api/v1/forms/families/{familyId}/responses": {
			"get": {
				"operationId": "whatsappForm.responses",
				"summary": "List a form's responses",
				"tags": [
					"WhatsappForm"
				],
				"x-fc-domain": "conversations",
				"x-fc-permission": "conversations:read",
				"x-fc-purpose": "Use it to get the responses of a form, across all its versions, with the contact and the value of each field.",
				"parameters": [
					{
						"name": "familyId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer"
						},
						"description": "ID of the form (family_id), the same in all its versions."
					},
					{
						"name": "from",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date"
						},
						"description": "From this date."
					},
					{
						"name": "to",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date"
						},
						"description": "Up to this date."
					},
					{
						"name": "version_id",
						"in": "query",
						"schema": {
							"type": "integer"
						},
						"description": "Only this version."
					},
					{
						"name": "origin",
						"in": "query",
						"schema": {
							"type": "string"
						},
						"description": "Origin of the send (for example api or automation)."
