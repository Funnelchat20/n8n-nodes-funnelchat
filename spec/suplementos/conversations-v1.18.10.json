		"/api/v1/contacts/{contact}/message/form": {
			"post": {
				"operationId": "whatsappFormSend.store",
				"summary": "Enviar un formulario a un contacto",
				"tags": [
					"WhatsappForm"
				],
				"x-fc-domain": "conversations",
				"x-fc-permission": "conversations:send",
				"x-fc-proposito": "Usalo para mandarle a un contacto un formulario publicado. Cuando lo completa llega el aviso whatsapp_form.completed con sus respuestas.",
				"parameters": [
					{
						"name": "contact",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer"
						},
						"description": "Contacto."
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"form_id",
									"device_id"
								],
								"properties": {
									"form_id": {
										"type": "integer",
										"description": "Id del formulario (family_id), no el de una versión: se envía la versión publicada."
									},
									"device_id": {
										"type": "integer",
										"description": "Número que lo envía; el formulario tiene que estar publicado en él."
									},
									"text": {
										"type": "string",
										"description": "Texto del mensaje (hasta 1024 caracteres). Por defecto, el nombre del formulario."
									},
									"button_text": {
										"type": "string",
										"description": "Texto del botón (hasta 30 caracteres, sin emojis). Por defecto «Abrir»."
									},
									"client_reference": {
										"type": [
											"string",
											"null"
										],
										"maxLength": 64,
										"description": "Tu identificador para este envío (1 a 64 caracteres ASCII visibles, sin espacios). Vuelve en el mensaje y en el aviso message.status_changed, para relacionarlos con tu sistema."
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "El mensaje en cola, type whatsapp_form.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"message": {
											"$ref": "#/components/schemas/SupPublicMessage"
										}
									}
								}
							}
						}
					}
				},
				"x-fc-nota": "Con una clave responde 200 con el mensaje en cola (status queued) y su id; el resultado llega después en el aviso message.status_changed. Pasan las guardas de WhatsApp: ventana de 24 horas (422 window_closed), ritmo (429 rate_limited) y antibloqueo (422 antiblock_…). Errores propios: 404 form_not_found y 422 form_not_published, form_not_on_number, number_not_eligible."
			}
		}
