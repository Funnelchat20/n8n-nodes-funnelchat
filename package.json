{
	"name": "@funnelchat-hq/n8n-nodes-funnelchat",
	"version": "0.1.0",
	"description": "n8n community node for the Funnelchat public API: actions on contacts, conversations and messages, templates, WhatsApp forms, groups, numbers and webhooks, and a trigger for signed webhooks.",
	"license": "MIT",
	"homepage": "https://developers-portal.funnelchat.app/docs/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"funnelchat",
		"whatsapp",
		"crm"
	],
	"author": {
		"name": "Funnelchat",
		"email": "soporte@funnelchat.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Funnelchat20/n8n-nodes-funnelchat.git"
	},
	"bugs": {
		"url": "https://github.com/Funnelchat20/n8n-nodes-funnelchat/issues",
		"email": "soporte@funnelchat.com"
	},
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.15"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FunnelchatApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Funnelchat/Funnelchat.node.js",
			"dist/nodes/FunnelchatTrigger/FunnelchatTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^22.20.5",
		"eslint": "9.29.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
